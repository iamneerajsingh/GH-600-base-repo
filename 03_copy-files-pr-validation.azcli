# Step 3: Run these copy commands in PowerShell.
New-Item -ItemType Directory -Path "$TARGET_REPO\tests" -Force
Copy-Item "$GH600_REPO\tests\*" "$TARGET_REPO\tests" -Recurse -Force
Copy-Item "$GH600_REPO\requirements-test.txt" "$TARGET_REPO\requirements-test.txt" -Force
Copy-Item "$GH600_REPO\pytest.ini" "$TARGET_REPO\pytest.ini" -Force
Copy-Item "$GH600_REPO\package.json" "$TARGET_REPO\package.json" -Force
Copy-Item "$GH600_REPO\package-lock.json" "$TARGET_REPO\package-lock.json" -Force
Copy-Item "$GH600_REPO\.github\workflows\pr-validation.yml" "$TARGET_REPO\.github\workflows\pr-validation.yml" -Force